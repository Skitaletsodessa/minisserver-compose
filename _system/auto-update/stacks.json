{
  "_comment": "Task 35 C2. Order = least critical first. policy: patch | minor | digest | ha | manual (see container-update.py). cmd = extra health command (rc 0 = healthy); containers = container names that must run (and be healthy where they have a HEALTHCHECK). guard=true: recreated only when ha_guard.py says the house is idle (Task 35b-1). gate=<script {image}>: test suites on the NEW image before deploy (Task 35b-2).",
  "entries": [
    {"name": "diun", "dir": "/srv/compose/diun", "policy": "patch", "members": [{"service": "diun", "image": "crazymax/diun", "container": "diun"}], "containers": ["diun"], "timeout": 120},
    {"name": "scrutiny", "dir": "/srv/compose/scrutiny", "policy": "patch", "members": [{"service": "scrutiny", "image": "ghcr.io/analogj/scrutiny", "container": "scrutiny"}], "containers": ["scrutiny"], "cmd": "curl -sf -m10 http://127.0.0.1:8080/api/health >/dev/null", "timeout": 180},
    {"name": "go2rtc", "dir": "/srv/compose/go2rtc", "policy": "patch", "members": [{"service": "go2rtc", "image": "ghcr.io/alexxit/go2rtc", "container": "go2rtc"}], "containers": ["go2rtc"], "cmd": "curl -sf -m5 http://127.0.0.1:18984/api >/dev/null && /srv/compose/go2rtc/check-bind.sh >/dev/null", "timeout": 120},
    {"name": "relay-tunnel", "dir": "/srv/compose/relay-tunnel", "policy": "patch", "members": [{"service": "cloudflared", "image": "cloudflare/cloudflared", "container": "relay-tunnel"}], "containers": ["relay-tunnel"], "cmd": "docker logs --since 150s relay-tunnel 2>&1 | grep -q 'Registered tunnel connection'", "timeout": 200},
    {"name": "adguard-sync", "dir": "/srv/compose/adguard-sync", "policy": "patch", "members": [{"service": "adguard-sync", "image": "ghcr.io/bakito/adguardhome-sync", "container": "adguard-sync"}], "containers": ["adguard-sync"], "cmd": "docker logs --since 150s adguard-sync 2>&1 | grep -q 'Sync done'", "timeout": 240},
    {"name": "navidrome", "dir": "/srv/compose/navidrome", "policy": "patch", "members": [{"service": "navidrome", "image": "deluan/navidrome", "container": "navidrome"}], "containers": ["navidrome"], "cmd": "curl -sf -m10 http://192.168.31.2:4533/ping >/dev/null", "timeout": 180},
    {"name": "jellyfin", "dir": "/srv/compose/jellyfin", "policy": "digest", "members": [{"service": "jellyfin", "image": "jellyfin/jellyfin", "container": "jellyfin"}], "containers": ["jellyfin"], "cmd": "curl -sf -m10 http://192.168.31.2:8096/health >/dev/null", "timeout": 240},
    {"name": "immich-redis", "dir": "/srv/compose/immich", "policy": "digest", "members": [{"service": "redis", "image": "docker.io/valkey/valkey", "container": "immich_redis"}], "containers": ["immich_redis"], "cmd": "docker exec immich_redis valkey-cli ping | grep -q PONG", "timeout": 120},
    {"name": "immich", "dir": "/srv/compose/immich", "policy": "minor", "source": "github:immich-app/immich", "before_update": "/srv/compose/_system/restic-backup/backup-dump.sh", "members": [{"service": "immich-server", "image": "ghcr.io/immich-app/immich-server", "container": "immich_server"}, {"service": "immich-machine-learning", "image": "ghcr.io/immich-app/immich-machine-learning", "container": "immich_machine_learning"}], "containers": ["immich_server", "immich_machine_learning", "immich_postgres", "immich_redis"], "cmd": "curl -sf -m10 http://192.168.31.2:2283/api/server/ping >/dev/null", "timeout": 420},
    {"name": "homeassistant", "dir": "/srv/compose/homeassistant", "policy": "ha", "members": [{"service": "homeassistant", "image": "ghcr.io/home-assistant/home-assistant", "container": "homeassistant"}], "containers": ["homeassistant"], "cmd": "[ \"$(ss -tln | awk '$4 ~ /:8123$/ {print $4}' | tr '\\n' ' ')\" = '127.0.0.1:8123 ' ] && curl -sf -m10 -o /dev/null http://127.0.0.1:8123/manifest.json", "timeout": 420, "guard": true},
    {"name": "relay", "dir": "/srv/compose/relay", "policy": "build", "base_tag": "python:3.13-slim-trixie", "service": "relay", "image": "relay:local", "smoke": "docker run --rm --entrypoint python {image} -c \"compile(open('/app/relay.py').read(), 'relay.py', 'exec')\"", "containers": ["relay"], "timeout": 180, "gate": "/srv/compose/_system/auto-update/gates/gate-relay.sh {image}"},
    {"name": "portal-schedules", "dir": "/srv/compose/portal/schedules", "policy": "build", "base_tag": "python:3.13-slim-trixie", "service": "portal-schedules", "image": "portal-schedules:local", "smoke": "docker run --rm --entrypoint python {image} -c \"import sched.server\"", "containers": ["portal-schedules"], "timeout": 240, "gate": "/srv/compose/_system/auto-update/gates/gate-schedules.sh {image}"},
    {"name": "portal-gateway", "dir": "/srv/compose/portal/gateway", "policy": "build", "base_tag": "python:3.13-slim-trixie", "service": "portal-gateway", "image": "portal-gateway:local", "smoke": "docker run --rm --entrypoint python {image} -c \"import gw.server\"", "containers": ["portal-gateway"], "cmd": "/srv/compose/portal/gateway/check-bind.sh >/dev/null", "timeout": 240, "guard": true, "gate": "/srv/compose/_system/auto-update/gates/gate-gateway.sh {image}"},
    {"name": "immich-postgres", "dir": "/srv/compose/immich", "policy": "manual", "reason": "pinned with the vectorchord/pgvectors extension versions the Immich release was tested with", "members": [{"service": "database", "image": "ghcr.io/immich-app/postgres", "container": "immich_postgres"}], "containers": ["immich_postgres"]},
    {"name": "qbittorrent", "dir": "/srv/compose/qbittorrent", "policy": "manual", "reason": "linuxserver tag scheme (5.2.3_v2.0.14-ls476); Diun announces", "members": [{"service": "qbittorrent", "image": "lscr.io/linuxserver/qbittorrent", "container": "qbittorrent"}], "containers": ["qbittorrent"]},
    {"name": "adguard", "dir": "/srv/compose/adguard", "policy": "manual", "reason": "origin (server) and replica (Pi) must move the same day; Diun announces, done by hand", "members": [{"service": "adguardhome", "image": "adguard/adguardhome", "container": "adguardhome"}], "containers": ["adguardhome"]}
  ]
}
