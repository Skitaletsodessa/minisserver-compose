[Unit]
Description=Pull motion clips of the front-yard camera (192.168.31.95) from its SD card into /srv/library/camera; every 15 min, fresh first, staged on the NVMe at night (Task 34, 34c)
RequiresMountsFor=/srv/library
After=network-online.target
Wants=network-online.target
OnFailure=backup-notify@%n.service

[Service]
Type=oneshot
User=skit
Nice=15
IOSchedulingClass=idle
StateDirectory=camera-pull camera-staging
WorkingDirectory=/srv/compose/_system/camera-pull
ExecStart=/usr/bin/python3 /srv/compose/_system/camera-pull/camera_pull.py
TimeoutStartSec=1800
