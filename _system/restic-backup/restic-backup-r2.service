[Unit]
Description=Daily restic backup of the backup set to the off-site repository (Cloudflare R2)
After=restic-backup.service network-online.target
Wants=network-online.target
OnFailure=backup-notify@%n.service

[Service]
Type=oneshot
User=root
ExecStart=/srv/compose/_system/restic-backup/restic-backup.sh r2
