#!/bin/bash
# Task 21 / 24 mutual watchdog, the Pi's half: does the SERVER's AdGuard Home (192.168.31.2) really answer?
# A real A record for a normal name AND the known-blocked name sinkholed. 3 consecutive bad checks -> alert through
# watchnotify (first message, a REMINDER every 6 h while it lasts, recovery with the outage duration). Trade-off stated in
# CLAUDE.md: the Pi holds a Telegram bot token (/etc/piserver/telegram.env, mode 600) - it can only SEND messages.
# Test mode: WATCH_TARGET=<dead address> (messages get "[TEST] "), WATCH_STATE_DIR, WATCH_REMIND_SECONDS.
set -uo pipefail
TARGET=${WATCH_TARGET:-192.168.31.2}
[ -n "${WATCH_TARGET:-}" ] && export WATCH_TEST=1
COUNT_DIR=${STATE_DIRECTORY:-/var/lib/adguard-watch-origin}
export WATCH_ENV_FILE=${WATCH_ENV_FILE:-/etc/piserver/telegram.env}
export WATCH_STATE_DIR=${WATCH_STATE_DIR:-$COUNT_DIR/alerts}
NOTIFY="python3 /usr/local/lib/watchnotify.py"
mkdir -p "$COUNT_DIR"
n=$(dig @"$TARGET" example.com +short +time=3 +tries=1 A 2>/dev/null)
b=$(dig @"$TARGET" doubleclick.net +short +time=3 +tries=1 A 2>/dev/null)
ok_n=false; echo "$n" | grep -qE '^[0-9]{1,3}(\.[0-9]{1,3}){3}$' && ok_n=true
ok_b=false; [ "$b" = "0.0.0.0" ] && ok_b=true
if $ok_n && $ok_b; then
  echo 0 > "$COUNT_DIR/count"
  $NOTIFY clear adguard-origin "piserver adguard-watch: the ORIGIN AdGuard on the server ($TARGET) answers again (normal and blocked-domain checks pass)."
  exit 0
fi
c=$(( $(cat "$COUNT_DIR/count" 2>/dev/null || echo 0) + 1 )); echo "$c" > "$COUNT_DIR/count"
echo "check failed (normal_ok=$ok_n blocked_ok=$ok_b) consecutive=$c" >&2
if [ "$c" -ge 3 ]; then
  $NOTIFY alert adguard-origin "piserver adguard-watch: the ORIGIN AdGuard on the server ($TARGET) failed $c consecutive checks.
normal (example.com): ${n:-<none>}; blocked (doubleclick.net): ${b:-<none>} (expected 0.0.0.0). The house is being served by this Pi's replica."
fi
exit 0
