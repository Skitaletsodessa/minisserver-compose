#!/bin/bash
# Run on the Pi by the server's forced-command SSH key (Task 22). Read-only report, one line each.
# The only thing it changes is the apt package list (apt-get update) - no package is installed.
# Quick mode for the server heartbeat (ssh ... age): just the watchdog age, no apt (apt-get update alone takes ~40 s on this Pi
# and made the daily heartbeat time out on 2026-10-05).
f=/var/lib/adguard-watch-origin/count
age() { [ -f "$f" ] && echo "origin_watch_age_s=$(( $(date +%s) - $(stat -c %Y "$f") ))" || echo "origin_watch_age_s=none"; }
[ "${SSH_ORIGINAL_COMMAND:-}" = "age" ] && { age; exit 0; }
echo "throttled=$(vcgencmd get_throttled | cut -d= -f2)"
echo "temp=$(vcgencmd measure_temp | cut -d= -f2)"
echo "uptime=$(uptime -p)"
echo "root_used=$(df --output=pcent / | tail -1 | tr -d ' ')"
echo "sd_written_mib=$(awk '$3=="mmcblk0"{printf "%d", $10/2048}' /proc/diskstats)"
sudo -n apt-get update -qq >/dev/null 2>&1
n=$(apt-get -s upgrade 2>/dev/null | grep -c '^Inst ')
sec=$(apt-get -s upgrade 2>/dev/null | grep '^Inst ' | grep -ci 'security')
echo "upgradable=$n security=$sec"
apt-get -s upgrade 2>/dev/null | grep '^Inst ' | awk '{print $2}' | head -20 | tr '\n' ' '; echo
# Task 24: has the Pi-side watchdog (adguard-watch-origin, every minute) run lately? Age of its counter file in seconds.
age
