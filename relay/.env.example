# Real values only in the git-ignored .env (mode 600).
# Generate: openssl rand -hex 32   (the same value goes into the Worker secret RELAY_SECRET)
RELAY_SECRET=
# Politeness / limits (defaults are conservative; the daily cap is a placeholder until Ivan gives his real volume)
RELAY_DAILY_CAP=600
RELAY_RATE_PER_SEC=1
RELAY_BURST=3
RELAY_HOST_CONCURRENCY=2
# Peers whose X-Forwarded-For / CF-Connecting-IP is trusted for the per-source auth-failure limit (the tunnel's address)
RELAY_TRUSTED_PROXIES=172.30.0.1
