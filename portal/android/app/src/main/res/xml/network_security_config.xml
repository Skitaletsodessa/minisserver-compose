<?xml version="1.0" encoding="utf-8"?>
<!-- Clear text is forbidden everywhere; only the system's certificate authorities are trusted (the gateway's certificate is a normal Let's Encrypt one from Tailscale). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
