# Task 28 portal-gateway. Same base as portal-schedules, pinned by digest (python:3.13-slim-trixie, Python 3.13.16, pulled 2026-10-19).
# Diun watches the upstream repo through /srv/compose/diun/caddy.yml; the labels in compose.yaml say which image this one is built on.
# Dependencies are installed ONLY with --require-hashes (requirements.txt is generated by pin-requirements.py).
FROM python@sha256:70729b46c69b4f1e97c4822c1af3df53a1476cf5ddc6c087c0c10bc3a5678c2f
RUN useradd --system --uid 1000 --no-create-home --shell /usr/sbin/nologin portal \
 && mkdir /app /data /secrets && chown 1000:1000 /data
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /app/requirements.txt
COPY gw /app/gw
USER 1000:1000
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 GW_DATA=/data
CMD ["python", "-m", "gw.server"]
