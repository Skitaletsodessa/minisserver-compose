# Immich stack - copy to .env (git-ignored) and fill DB_PASSWORD. Upstream reference:
# https://docs.immich.app/install/environment-variables
IMMICH_VERSION=v3.2.2
# Tier-1: originals, profile pictures. On the NVMe /srv/data. NEVER on the Seagate.
UPLOAD_LOCATION=/srv/data/immich
# Postgres data directory. NVMe /srv/data. Local disk only (no network shares).
DB_DATA_LOCATION=/srv/data/immich-postgres
# Rebuildable, on /srv/apps, in no backup: thumbnails+previews, transcoded video, ML models.
THUMB_LOCATION=/srv/apps/immich-derived/thumbs
ENCODED_VIDEO_LOCATION=/srv/apps/immich-derived/encoded-video
ML_CACHE_LOCATION=/srv/apps/immich-ml-cache
# Storage-template dates are rendered in the server's local timezone, so this matters.
TZ=Europe/Prague
# A-Za-z0-9 only (upstream requirement). Generate: openssl rand -hex 24
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
